# Local development only. In production these live in GitHub (Settings → Secrets and variables → Actions)
# and the Deploy workflow passes them on: see README → Deploying.

# Fare data — leave empty to run in demo mode with clearly-labelled sample prices.
# Travelpayouts → Profile → API token. https://app.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Travelpayouts partner marker (your affiliate ID), appended to Aviasales links.
TRAVELPAYOUTS_MARKER=

# Travelstart affiliate tracking link from Impact (e.g. https://travelstart.pxf.io/c/xxx/yyy/zzz).
# Leave empty and the "View on Travelstart" button stays hidden.
TRAVELSTART_AFFILIATE_LINK=

# Click logging. Server-only — never expose the service role key to the browser.
# Leave empty and clicks are logged to the server console instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
